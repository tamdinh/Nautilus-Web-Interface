# ─────────────────────────────────────────────────────────────────────────────
# Nautilus Web Interface — Environment Variables
# Copy this file to .env and fill in the values before running in production.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED in production) ────────────────────────────────────────

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Admin account password — must be at least 12 chars
ADMIN_PASSWORD=change-me-strong-password

# Encryption key for stored exchange API credentials (Fernet). REQUIRED.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up SEPARATELY from the database: losing it makes stored credentials unrecoverable.
# For rotation put the new key first, comma-separated: NEW_KEY,OLD_KEY
ENCRYPTION_KEY=

# "production" (default) = refuse to start with missing/weak secrets.
# Use "development" ONLY on a local machine.
ENVIRONMENT=production

# Reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (client IP for rate limiting).
# Behind Traefik/Dokploy set the proxy network, e.g. 172.18.0.0/16
FORWARDED_ALLOW_IPS=127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
# In production set to your actual frontend URL, e.g.:
#   CORS_ORIGINS=https://myapp.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend URLs (used at build time) ───────────────────────────────────────

# In production set to your actual server addresses, e.g.:
#   VITE_NAUTILUS_API_URL=https://api.myapp.example.com
VITE_NAUTILUS_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Optional API Key Auth ─────────────────────────────────────────────────────

# Leave empty to use JWT-only authentication (recommended)
# Set to a random string to enable API key auth as alternative: openssl rand -hex 32
API_KEY=

# ── Ports ─────────────────────────────────────────────────────────────────────

BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT_PER_MINUTE=200
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ── JWT ───────────────────────────────────────────────────────────────────────

JWT_EXPIRE_HOURS=8
